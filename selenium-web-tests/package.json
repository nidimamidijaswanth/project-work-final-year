  "license": "ISC",
  "dependencies": {
    "chai": "^5.1.2",
    "chromedriver": "^131.0.0",
    "geckodriver": "^4.5.1",
    "mocha": "^11.0.1",
    "selenium-webdriver": "^4.27.0"
  }
}
