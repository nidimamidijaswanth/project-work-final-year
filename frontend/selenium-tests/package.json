{
  "name": "focusai-frontend-selenium-tests",
  "version": "2.0.0",
  "description": "FocusAI Selenium WebDriver E2E Automation Suite - 1,100 assertions across 110 categories",
  "main": "tests/mega_web_1100.test.js",
  "type": "module",
  "scripts": {
    "test": "mocha tests/**/*.test.js --timeout 120000 --exit",
    "test:mega": "mocha tests/mega_web_1100.test.js --timeout 120000 --exit --reporter spec",
    "test:login": "mocha tests/login.test.js --timeout 60000 --exit",
    "report:excel": "node utils/excelReporter.js",
    "report:html": "node utils/htmlReportGenerator.js",
    "report:all": "node utils/excelReporter.js && node utils/htmlReportGenerator.js",
    "ci": "mocha tests/mega_web_1100.test.js --timeout 120000 --exit --reporter spec && npm run report:all"
  },
  "dependencies": {
    "chai": "^4.3.10",
    "exceljs": "^4.3.0",
    "mocha": "^10.2.0",
    "selenium-webdriver": "^4.16.0"
  }
}
