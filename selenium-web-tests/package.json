{
  "name": "focusai-web-selenium-e2e-tests",
  "version": "1.0.0",
  "description": "Dedicated Selenium WebDriver E2E Automation Testing Suite for FocusAI Web Application in Node.js",
  "main": "tests/e2e-complete-web.test.js",
  "type": "module",
  "scripts": {
    "test": "mocha tests/**/*.test.js --timeout 60000",
