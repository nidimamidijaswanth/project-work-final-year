   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="9" ss:Bold="1"/>
  </Style>
  <Style ss:ID="DataCellNum">
   <Alignment ss:Horizontal="Right"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E0E0E0"/>
