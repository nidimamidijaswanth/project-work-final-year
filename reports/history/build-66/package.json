{
  "name": "focusai-appium-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FocusAI Android Appium E2E Suite — 1,111 parameterized tests across 11 categories",
  "scripts": {
    "test": "node node_modules/@wdio/cli/bin/wdio.js run wdio.conf.js",
    "test:ci": "WDIO_CI_SPEC=./tests/12_e2e/mega_android_1100.test.js node node_modules/@wdio/cli/bin/wdio.js run wdio.conf.js",
    "report:excel": "node utils/xlsxReporter.js",
    "report:html": "node utils/generateHtmlReport.js",
    "report:summary": "node utils/generateSummary.js",
    "fallback": "node utils/generateFallbackReport.js"
  },
  "dependencies": {
    "@wdio/cli": "^8.39.0",
    "@wdio/local-runner": "^8.39.0",
    "@wdio/mocha-framework": "^8.39.0",
    "@wdio/spec-reporter": "^8.39.0",
    "appium": "^2.11.4",
    "exceljs": "^4.4.0",
    "webdriverio": "^8.39.0"
  }
}
